# Backend Server Configuration
HOST=127.0.0.1
PORT=5000
DEBUG=True

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Database Engine Selection ('mongodb' or 'mysql')
DB_ENGINE=mongodb

# MongoDB Database Configuration
MONGO_URI=mongodb://localhost:27017/
# Or for MongoDB Atlas in production:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/crowd_event_db?retryWrites=true&w=majority
MONGO_DB_NAME=crowd_event_db

# Legacy MySQL Database Configuration (Optional, if DB_ENGINE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crowd_event_db

# Frontend Client Origins (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
